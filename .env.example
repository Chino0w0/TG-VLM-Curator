# TG-VLM-Curator Production Environment Template
# Copy to `.env` (gitignored) and generate a 32-byte base64 master key at:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())" > secrets/app_master_key.txt
#   chmod 0400 secrets/app_master_key.txt

TGCURATOR_ENVIRONMENT=production
TGCURATOR_LOG_LEVEL=INFO
TGCURATOR_HTTP_PORT=8080

POSTGRES_USER=tgcurator
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=tgcurator

# Host path mounted read-only as Docker secret `/run/secrets/app_master_key`.
# Back up this key offline! Without `APP_MASTER_KEY`, encrypted Telegram sessions,
# bot tokens, and external VLM API keys in PostgreSQL cannot be decrypted.
TGCURATOR_MASTER_KEY_HOST_PATH=./secrets/app_master_key.txt
TGCURATOR_APP_MASTER_KEY_ID=primary

# Worker Horizontal/Vertical Concurrency Controls
# Note: External VLM/LLM inference servers live outside Compose and are configured
# through versioned InferenceProfiles in the Web Admin console.
WORKER_ANALYSIS_CONCURRENCY=4
WORKER_MEDIA_CONCURRENCY=2
WORKER_PUBLISH_CONCURRENCY=1
