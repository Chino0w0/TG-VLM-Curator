# Local development defaults. Copy to .env and replace values locally.
TGCURATOR_ENVIRONMENT=development
TGCURATOR_LOG_LEVEL=INFO
TGCURATOR_DATABASE_URL=postgresql+asyncpg://curator:change-me@localhost:5432/tgcurator

# Configure exactly one master-key source when encrypted secrets are used.
# The value must be base64 for exactly 32 random bytes. Never commit a real key.
# TGCURATOR_APP_MASTER_KEY=<base64-encoded-32-byte-key>
# TGCURATOR_APP_MASTER_KEY_FILE=C:\run\secrets\tgcurator-master-key
TGCURATOR_APP_MASTER_KEY_ID=primary
